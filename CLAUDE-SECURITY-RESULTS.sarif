              "preconditions": [
                "An authenticated session via open self-registration",
                "usernameXssChallenge not yet solved on the instance"
              ],
              "category": "Inefficient Regular Expression Complexity",
              "severity": "LOW",
              "confidence": "medium",
              "recommendation": "Replace the regex with a linear check and gate the predicate with utils.isChallengeEnabled as line 57 does: const img = user?.profileImage ?? ''; return username && /;\\s*script-src/.test(img) && img.includes(\"'unsafe-inline'\") && username.includes('<script>alert(`xss`)</script>'). Also cap profileImage length in routes/profileImageUrlUpload.ts.",
              "cwe_id": "CWE-1333",
              "snippet": "return username && user?.profileImage.match(/;[ ]*script-src(.)*'unsafe-inline'/g) !== null && username.includes('<script>alert(`xss`)</script>')",
              "symbol": "getUserProfile",
