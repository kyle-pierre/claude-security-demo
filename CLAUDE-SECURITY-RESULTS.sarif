                  "snippet": {
                    "text": "const yamlString = vm.runInContext('JSON.stringify(yaml.load(data))', sandbox, { timeout: 2000 })"
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "handleYamlUpload",
                  "fullyQualifiedName": "handleYamlUpload"
                }
              ]
