                  "snippet": {
                    "text": "export const isAuthorized = () => expressJwt(({ secret: publicKey }) as any)"
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "isAuthorized",
                  "fullyQualifiedName": "isAuthorized"
                }
              ]
            }
          ],
