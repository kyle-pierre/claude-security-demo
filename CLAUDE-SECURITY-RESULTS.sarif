                  "snippet": {
                    "text": "const users = await UserModel.findAll()"
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "retrieveUserList",
                  "fullyQualifiedName": "retrieveUserList"
                }
              ]
            }
          ],
