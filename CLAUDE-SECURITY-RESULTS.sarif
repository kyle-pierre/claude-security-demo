        {
          "ruleId": "CWE-22",
          "ruleIndex": 10,
          "level": "note",
          "message": {
            "text": "Backslash traversal on Windows reads any .md or .pdf file in the public FTP route.\n\nThe forward-slash check (line 17) does not stop backslash segments on Windows, and path.resolve makes them escape ftp/; the extension check (line 26) limits reads to .md and .pdf.\n\nImpact: Limited to .md and .pdf files on the Windows filesystem. Bounded read exposure.\n\nExploit scenario: GET /ftp/..\\..\\some-doc.md (URL-encoded) reads a markdown or PDF file from elsewhere on the drive.\n\nPreconditions: Server running on Windows; No authentication (server.ts:295-296).\n\nRecommendation: Apply the same containment: resolve against ftp/, require target.startsWith(base + path.sep), and reject backslashes before sendFile.\n\nCWE-22. Severity LOW, confidence medium."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "routes/fileServer.ts",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 32,
                  "snippet": {
                    "text": "res.sendFile(path.resolve('ftp/', file))"
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "verify",
                  "fullyQualifiedName": "verify"
                }
              ]
            }
          ],
          "properties": {
            "claudeSecurityPlugin": {
              "id": "F90",
              "title": "Backslash traversal on Windows reads any .md or .pdf file in the public FTP route",
              "impact": "Limited to .md and .pdf files on the Windows filesystem. Bounded read exposure.",
              "file": "routes/fileServer.ts",
              "line": 32,
              "description": "The forward-slash check (line 17) does not stop backslash segments on Windows, and path.resolve makes them escape ftp/; the extension check (line 26) limits reads to .md and .pdf.",
              "exploit_scenario": "GET /ftp/..\\..\\some-doc.md (URL-encoded) reads a markdown or PDF file from elsewhere on the drive.",
              "preconditions": [
                "Server running on Windows",
                "No authentication (server.ts:295-296)"
              ],
              "category": "Path Traversal",
              "severity": "LOW",
              "confidence": "medium",
              "recommendation": "Apply the same containment: resolve against ftp/, require target.startsWith(base + path.sep), and reject backslashes before sendFile.",
              "cwe_id": "CWE-22",
              "snippet": "res.sendFile(path.resolve('ftp/', file))",
              "symbol": "verify",
              "declared_line": 32,
              "via_change": null,
