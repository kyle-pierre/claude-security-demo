                    "text": "res.statusCode < 400 ? fileUploadsCountMetric.labels(file.mimetype).inc() : fileUploadErrorsMetric.labels(file.mimetype).inc()"
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "observeFileUploadMetricsMiddleware",
