              "preconditions": [
                "A valid session token for the victim"
              ],
              "category": "Improper Authentication",
              "severity": "MEDIUM",
              "confidence": "high",
              "recommendation": "Always require the current password and fail closed: if (!currentPassword || security.hash(currentPassword) !== loggedInUser.data.password) { res.status(401).send(res.__('Current password is not correct.')); return }. Also revoke the account's other tokens on password change.",
              "cwe_id": "CWE-620",
              "snippet": "if (currentPassword && security.hash(currentPassword) !== loggedInUser.data.password) {",
