                },
                "region": {
                  "startLine": 45,
                  "snippet": {
                    "text": "const fileWriter = doc.pipe(fs.createWriteStream(path.join('ftp/', pdfFile)))"
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "placeOrder",
                  "fullyQualifiedName": "placeOrder"
                }
              ]
            }
          ],
