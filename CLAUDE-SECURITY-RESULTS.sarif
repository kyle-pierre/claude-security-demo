              "category": "Exposure of Sensitive Information to an Unauthorized Actor",
              "severity": "LOW",
              "confidence": "medium",
              "recommendation": "Allowlist the fields that may be requested and drop the JSONP branch for credential-bearing responses:\n\nconst ALLOWED = ['id','email','username','lastLoginIp','profileImage'] as const\nif (!ALLOWED.includes(field)) continue\n\nRemove the res.jsonp path. Set SameSite=Strict on the token cookie.",
              "cwe_id": "CWE-200",
              "snippet": "baseUser[field] = user?.data[field as keyof typeof user.data]",
              "symbol": "retrieveLoggedInUser",
              "declared_line": 31,
